<Project Sdk="Microsoft.NET.Sdk">

  <!-- Service adapter: wraps WF.Compiler for one job per process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CompilerJob</AssemblyName>
    <PlatformTarget Condition="'$(CompilerLinux)' != 'true'">x86</PlatformTarget>
    <RuntimeIdentifier Condition="'$(CompilerLinux)' != 'true'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(CompilerLinux)' == 'true'">linux-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(CompilerLinux)' != 'true'">true</SelfContained>
    <SelfContained Condition="'$(CompilerLinux)' == 'true'">false</SelfContained>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../WF.Compiler.csproj" />
  </ItemGroup>

</Project>
