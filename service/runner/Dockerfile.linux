# Build from the repository root for linux/amd64 or linux/arm64.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
ARG TARGETARCH
RUN case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; esac \
    && sh service/runner/build-lua-linux.sh /native
RUN dotnet publish service/runner/CompilerJob.csproj -c Release \
    -p:CompilerLinux=true -p:CompilerLinuxArch="$(if [ "$TARGETARCH" = amd64 ]; then echo x64; else echo arm64; fi)" -o /publish

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /publish/ .
COPY --from=build /native/libwherigo-lua51.so .
COPY --from=build /native/LUA-LICENSE.html .
ENV DOTNET_EnableDiagnostics=0
USER $APP_UID
ENTRYPOINT ["dotnet", "/app/CompilerJob.dll"]
