<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WF.Compiler</RootNamespace>
    <AssemblyName>WF.Compiler</AssemblyName>
    <Version>0.9.8</Version>

    <!-- The bundled Windows Lua DLL requires x86. -->
    <PlatformTarget Condition="'$(CompilerLinux)' != 'true'">x86</PlatformTarget>
    <RuntimeIdentifier Condition="'$(CompilerLinux)' != 'true'">win-x86</RuntimeIdentifier>
    <CompilerLinuxArch Condition="'$(CompilerLinuxArch)' == ''">x64</CompilerLinuxArch>
    <RuntimeIdentifier Condition="'$(CompilerLinux)' == 'true'">linux-$(CompilerLinuxArch)</RuntimeIdentifier>
    <!-- Self contained, so build machines and containers don't need an x86 .NET runtime installed -->
    <SelfContained Condition="'$(CompilerLinux)' != 'true'">true</SelfContained>
    <SelfContained Condition="'$(CompilerLinux)' == 'true'">false</SelfContained>

    <!-- Keep the original Properties/AssemblyInfo.cs (it uses a 0.9.8.* wildcard version) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <NoWarn Condition="'$(RuntimeIdentifier)' == 'win-x86'">$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="'$(CompilerLinux)' == 'true'">$(DefineConstants);LINUX_COMPILER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The website service has its own projects and Node files -->
    <Compile Remove="service/**" />
    <None Remove="service/**" />
    <EmbeddedResource Remove="service/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Condition="'$(CompilerLinux)' != 'true'" Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Condition="'$(CompilerLinux)' == 'true'" Include="SkiaSharp" Version="4.152.3" />
    <PackageReference Condition="'$(CompilerLinux)' == 'true'" Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource names must match the GetManifestResourceStream calls -->
    <EmbeddedResource Include="Resources/Wherigo.luac" LogicalName="WF.Compiler.Resources.Wherigo.luac" />
    <EmbeddedResource Include="Eluant/BindingSupport.lua" LogicalName="WF.Compiler.Eluant.BindingSupport.lua" />
    <None Condition="'$(CompilerLinux)' != 'true'" Update="lua5.1.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
